# 复制为 .env 后供 docker compose -f docker-compose.prod.yml 使用
# 必填项请替换占位符；勿提交真实 .env

MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=chtholly
MYSQL_PASSWORD=change_me_app_password
MYSQL_DATABASE=chtholly

# 2 vCPU / 4 GiB 单机资源预算；更大规格可按需覆盖
MYSQL_MEMORY_LIMIT=640M
MYSQL_MAX_CONNECTIONS=50
MYSQL_INNODB_BUFFER_POOL_SIZE=128M
REDIS_MEMORY_LIMIT=192M
REDIS_MAXMEMORY=128mb
ELASTICSEARCH_MEMORY_LIMIT=1200M
ES_JAVA_OPTS=-Xms512m -Xmx512m
SERVER_MEMORY_LIMIT=896M
SERVER_JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -XX:MaxMetaspaceSize=192m
WEB_MEMORY_LIMIT=384M
WEB_NODE_OPTIONS=--max-old-space-size=256
NGINX_MEMORY_LIMIT=64M
KAFKA_MEMORY_LIMIT=1G
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
HOST_SWAP_SIZE_GB=2

HTTP_PORT=80
HTTPS_PORT=443
NGINX_CONFIG_PATH=./docker/nginx/default.conf
TLS_DOMAIN=yourdomain.com
TLS_EMAIL=admin@yourdomain.com
SITE_OWNER_USER_ID=1
CHTHOLLY_USER_ID=888888888888888888
OWNER_HANDLE=Rekyrice
OWNER_NICKNAME=Rekyrice
OWNER_BOOTSTRAP_PASSWORD=change_me_owner_password

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/app/uploads

OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_PUBLIC_DOMAIN=
OSS_FOLDER=post

NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_OSS_PUBLIC_URL=

# 与 KAFKA_ENABLED 同时为 true 时选择互动 Kafka 路径；启用前必须确认 CDC 可达
CANAL_ENABLED=false
CANAL_PASSWORD=change_me_canal_password
COUNTER_KAFKA_PUBLISH_MAX_ATTEMPTS=3
COUNTER_KAFKA_PUBLISH_ACK_TIMEOUT=PT3S
COUNTER_KAFKA_CONSUMER_MAX_ATTEMPTS=3
COUNTER_KAFKA_CONSUMER_RETRY_BACKOFF=PT1S
COUNTER_KAFKA_CONSUMER_DLT_ACK_TIMEOUT=PT3S
COUNTER_CALIBRATION_ENABLED=true
COUNTER_CALIBRATION_FIXED_DELAY=PT5M
COUNTER_CALIBRATION_BATCH_SIZE=50

# 前端来源白名单（逗号分隔，需与站点 HTTPS 域名一致）
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# LLM / Agent（默认启用；两个 API key 必须由本地配置包或人工填写）
LLM_ENABLED=true
SWAGGER_ENABLED=false
SPRING_PROFILES_ACTIVE=llm
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
AGENT_MODEL=deepseek-chat
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_MAX_RESPONSE_CHARS=2000
AGENT_MAX_STEPS=10
AGENT_MEMORY_MAX_TURNS=20
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_TURN_TIMEOUT_SECONDS=60
AGENT_MEMORY_TTL_MINUTES=120

# Bangumi
BANGUMI_ENABLED=true
BANGUMI_ACCESS_TOKEN=
BANGUMI_SYNC_ENABLED=false

# compose 内服务互联，一般无需改：
# MYSQL_HOST=mysql
# REDIS_HOST=redis
# ES_URIS=http://elasticsearch:9200
ES_REPLICAS=0
# 低成本默认不启动 Kafka；启用时同时设置 COMPOSE_PROFILES=kafka 与 KAFKA_ENABLED=true
COMPOSE_PROFILES=
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SEED_PHASE_A=false

# Redis 密码（可选；启用时在 redis command 增加 --requirepass）
# REDIS_PASSWORD=
